---
import { getSeoSettings, type BreadcrumbItem } from '@/lib/seo';
interface Props { items: BreadcrumbItem[] }
const { items } = Astro.props;
const settings = await getSeoSettings(Astro.locals?.supabase ?? null);
---
{settings.breadcrumbs_enabled && items.length > 1 && (
  <nav class="seo-breadcrumbs container" aria-label="Breadcrumb">
    <ol>
      {items.map((item, index) => (
        <li>
          {index > 0 && <span class="seo-breadcrumbs__separator" aria-hidden="true">{settings.breadcrumbs_separator}</span>}
          {index === items.length - 1
            ? <span aria-current="page">{item.name}</span>
            : <a href={item.url}>{index === 0 ? settings.breadcrumbs_home_label : item.name}</a>}
        </li>
      ))}
    </ol>
  </nav>
)}
<style>
  .seo-breadcrumbs { padding-top: 112px; margin-bottom: -104px; position: relative; z-index: 2; }
  .seo-breadcrumbs ol { display: flex; align-items: center; flex-wrap: wrap; gap: 0; list-style: none; margin: 0; padding: 0; font-size: 12px; color: var(--ink-2); }
  .seo-breadcrumbs li { display: inline-flex; align-items: center; min-width: 0; }
  .seo-breadcrumbs a { color: var(--ink-2); text-decoration: none; }
  .seo-breadcrumbs a:hover { color: var(--brand); }
  .seo-breadcrumbs [aria-current="page"] { overflow: hidden; max-width: 30ch; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); }
  .seo-breadcrumbs__separator { margin: 0 .55rem; color: var(--line-strong); }
  @media (max-width: 640px) { .seo-breadcrumbs { padding-top: 92px; margin-bottom: -86px; } }
</style>
