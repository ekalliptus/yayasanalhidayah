---
// Every SEO-relevant tag in one place. Base.astro resolves the SEO model and
// hands it here; the article page and any future template reuse the same
// component, so the admin panel is the single source of truth for <head>.
import type { SeoSettings } from '@/lib/seo';
import type { ResolvedSeo } from '@/lib/seo';

interface Props {
  seo: ResolvedSeo;
  settings: SeoSettings;
  jsonLd: unknown;
  /** Article-only OpenGraph extras. */
  article?: {
    publishedAt?: string | null;
    modifiedAt?: string | null;
    section?: string;
    tags?: string[];
    authorName?: string;
  };
}

const { seo, settings, jsonLd, article } = Astro.props;

const verifications: { name: string; content: string }[] = [
  { name: 'google-site-verification', content: settings.gsc_verification },
  { name: 'msvalidate.01', content: settings.bing_verification },
  { name: 'yandex-verification', content: settings.yandex_verification },
  { name: 'baidu-site-verification', content: settings.baidu_verification },
  { name: 'p:domain_verify', content: settings.pinterest_verification },
  { name: 'norton-safeweb-site-verification', content: settings.norton_verification },
].filter((v) => v.content.trim().length > 0);

const geoLat = settings.geo_lat.trim();
const geoLng = settings.geo_lng.trim();
const hasGeo = geoLat !== '' && geoLng !== '';
const ga4Id = settings.ga4_id;
const gtmId = settings.gtm_id;
// JSON-LD is inserted with set:html. Escape '<' so an admin-controlled string
// containing </script> cannot terminate the script element.
const safeJsonLd = JSON.stringify(jsonLd)
  .replace(/</g, '\\u003c')
  .split(String.fromCharCode(0x2028)).join('\\u2028')
  .split(String.fromCharCode(0x2029)).join('\\u2029');
---
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content={seo.robots} />
<link rel="canonical" href={seo.canonical} />
<link rel="alternate" hreflang="id" href={seo.canonical} />
<link rel="alternate" hreflang="x-default" href={seo.canonical} />

{verifications.map((v) => <meta name={v.name} content={v.content} />)}

{hasGeo && (
  <>
    <meta name="geo.region" content="ID-JB" />
    <meta name="geo.placename" content={settings.address_region} />
    <meta name="geo.position" content={`${geoLat};${geoLng}`} />
    <meta name="ICBM" content={`${geoLat}, ${geoLng}`} />
  </>
)}

<!-- Open Graph -->
<meta property="og:title" content={seo.ogTitle} />
<meta property="og:description" content={seo.ogDescription} />
<meta property="og:type" content={seo.ogType} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:locale" content={seo.locale} />
<meta property="og:site_name" content={seo.siteName} />
{/* No og:image:width/height — the URL is CMS-overridable, so hardcoded
    dimensions would lie for any custom image. Crawlers fetch and measure. */}
<meta property="og:image" content={seo.ogImage} />
{seo.ogImage.startsWith('https://') && <meta property="og:image:secure_url" content={seo.ogImage} />}
<meta property="og:image:alt" content={seo.ogImageAlt} />
{settings.facebook_app_id && <meta property="fb:app_id" content={settings.facebook_app_id} />}

{article && (
  <>
    {article.publishedAt && <meta property="article:published_time" content={article.publishedAt} />}
    {article.modifiedAt && <meta property="article:modified_time" content={article.modifiedAt} />}
    {article.section && <meta property="article:section" content={article.section} />}
    {article.authorName && <meta property="article:author" content={article.authorName} />}
    {article.authorName && <meta name="twitter:label1" content="Ditulis oleh" />}
    {article.authorName && <meta name="twitter:data1" content={article.authorName} />}
    {(article.tags ?? []).map((t) => <meta property="article:tag" content={t} />)}
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content={seo.twitterCard} />
<meta name="twitter:title" content={seo.twitterTitle} />
<meta name="twitter:description" content={seo.twitterDescription} />
<meta name="twitter:image" content={seo.twitterImage} />
<meta name="twitter:image:alt" content={seo.ogImageAlt} />
{seo.twitterSite && <meta name="twitter:site" content={seo.twitterSite} />}
{seo.twitterSite && <meta name="twitter:creator" content={seo.twitterSite} />}

{/* Analytics — IDs are format-validated in settings.ts before interpolation. */}
{ga4Id && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>}
{ga4Id && (
  <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4Id}');`} />
)}
{gtmId && (
  <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`} />
)}

<!-- Structured Data -->
<script type="application/ld+json" is:inline set:html={safeJsonLd} />
