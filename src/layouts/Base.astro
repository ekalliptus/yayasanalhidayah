---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import {
  getSeoSettings, getPageSeo, resolveSeo, buildSchemaGraph,
  type SeoKind, type RobotsToken, type BreadcrumbItem,
} from '@/lib/seo';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  ogImage?: string;
  /** Skip the title template (page passes a fully-formed title). */
  rawTitle?: boolean;
  kind?: SeoKind;
  /** Per-article SEO, forwarded straight from the CMS row. */
  robots?: RobotsToken[] | null;
  ogTitle?: string | null;
  ogDescription?: string | null;
  twitterTitle?: string | null;
  twitterDescription?: string | null;
  twitterImage?: string | null;
  schemaType?: string | null;
  breadcrumbs?: BreadcrumbItem[];
  article?: {
    title: string;
    schemaData?: Record<string, unknown>;
    image?: string;
    publishedAt?: string | null;
    modifiedAt?: string | null;
    authorName?: string;
    section?: string;
    keywords?: string[];
    wordCount?: number;
    excerpt?: string;
    focusKeyword?: string;
  };
  page?: number;
}

const {
  title, description, noindex = false, canonical, ogImage, rawTitle = false,
  kind, robots = null, ogTitle = null, ogDescription = null,
  twitterTitle = null, twitterDescription = null, twitterImage = null,
  schemaType = null, breadcrumbs = [], article, page = 1,
} = Astro.props;

const client = Astro.locals?.supabase ?? null;
const pathname = Astro.url.pathname;
// Global settings + any per-path override the admin configured. Both are
// cached per-isolate for a minute, so this is not a per-request DB round trip.
const [settings, pageOverride] = await Promise.all([
  getSeoSettings(client),
  getPageSeo(client, pathname),
]);

const resolvedKind: SeoKind = kind ?? (pathname === '/' ? 'home' : 'page');
// A row for `/artikel` must not overwrite category/tag/search archive metadata,
// because those query variants have distinct canonical URLs and titles.
const effectivePageOverride = resolvedKind === 'archive' && Astro.url.search ? null : pageOverride;

const seo = resolveSeo(
  {
    kind: resolvedKind,
    pathname,
    title,
    description,
    rawTitle,
    noindex,
    canonical,
    ogImage,
    robots,
    ogTitle,
    ogDescription,
    twitterTitle,
    twitterDescription,
    twitterImage,
    excerpt: article?.excerpt,
    authorName: article?.authorName,
    publishedAt: article?.publishedAt,
    modifiedAt: article?.modifiedAt,
    category: article?.section,
    tags: article?.keywords,
    focusKeyword: article?.focusKeyword,
    page,
  },
  settings,
  effectivePageOverride,
);

const jsonLd = buildSchemaGraph(
  {
    kind: resolvedKind,
    seo,
    schemaType: schemaType ?? effectivePageOverride?.schema_type ?? null,
    breadcrumbs: settings.breadcrumbs_enabled ? breadcrumbs : [],
    article,
    faqs: schemaType === 'FAQPage' && article?.schemaData && Array.isArray(article.schemaData.faqs) ? article.schemaData.faqs as { question: string; answer: string }[] : undefined,
    howTo: schemaType === 'HowTo' && article?.schemaData && Array.isArray(article.schemaData.steps) ? { name: String(article.schemaData.name || article.title), steps: article.schemaData.steps.filter((step): step is string => typeof step === 'string') } : undefined,
  },
  settings,
);
---

<!doctype html>
<html lang="id" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#FFFFF0" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0E1525" media="(prefers-color-scheme: dark)" />
  <link rel="preload" as="image" href="/hero/hero-1.webp" type="image/webp" fetchpriority="high" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://wa.me" />

  <SeoHead
    seo={seo}
    settings={settings}
    jsonLd={jsonLd}
    article={article && {
      publishedAt: article.publishedAt,
      modifiedAt: article.modifiedAt,
      section: article.section,
      tags: article.keywords,
      authorName: article.authorName,
    }}
  />

  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/logo.webp" type="image/webp" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="Artikel Yayasan Alhidayah" href="/rss.xml" />

  <!-- Fonts — single combined request, async loaded -->
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=optional"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=optional" /></noscript>

  <!-- Theme init (prevent flash) -->
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('theme');
      if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
    })();
  </script>
</head>
<body>
  {settings.gtm_id && (
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${settings.gtm_id}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
  )}
  <slot />

  <script is:inline>
    (function() {
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('[data-reveal],[data-reveal-img]').forEach(function(el) { io.observe(el); });
    })();
  </script>
  <script is:inline>
    (window.requestIdleCallback || setTimeout)(function() {
      document.querySelectorAll('img[loading="lazy"]').forEach(function(img) {
        function r() { img.classList.add('loaded'); var p = img.closest('.skeleton'); if (p) p.classList.remove('skeleton'); }
        if (img.complete) r(); else img.addEventListener('load', r);
      });
      var hs = document.querySelectorAll('.hero-slide');
      if (hs.length > 1) { var c = 0; setInterval(function() { hs[c].classList.remove('active'); c = (c + 1) % hs.length; hs[c].classList.add('active'); }, 3000); }
      var cio = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (!e.isIntersecting) return;
          var el = e.target, t = +el.getAttribute('data-counter'), s = el.getAttribute('data-suffix') || '', d = t > 100 ? 2000 : 1200, st = 0;
          el.textContent = '0' + s;
          (function step(ts) { if (!st) st = ts; var p = Math.min((ts - st) / d, 1), c1 = 1.70158, v = Math.min(Math.round((1 + (c1+1) * Math.pow(p-1,3) + c1 * Math.pow(p-1,2)) * t), t); el.textContent = v + s; p < 1 ? requestAnimationFrame(step) : (el.textContent = t + s, el.classList.add('counter-done')); })(performance.now());
          cio.unobserve(el);
        });
      }, { threshold: 0.5 });
      document.querySelectorAll('[data-counter]').forEach(function(el) { cio.observe(el); });
    });
  </script>
</body>
</html>
